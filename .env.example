# Copy to .env.local and fill in. Nothing here is committed.

# ── Razorpay ───────────────────────────────────────────────
# Test keys during development, live keys at launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in Razorpay Dashboard → Webhooks.
# Subscribe to: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID. This one reaches the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Supabase ───────────────────────────────────────────────
# Run supabase/schema.sql once in the SQL editor first.
SUPABASE_URL=
# Service role key. Server only — the browser never talks to Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# ── Bulk quote form ────────────────────────────────────────
# Web3Forms access key. Safe to expose.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ── Tracking (optional; each is skipped if blank) ──────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# ── Operations (optional) ──────────────────────────────────
# Slack or Telegram webhook. Alerts on overflow payments needing a refund.
ALERT_WEBHOOK_URL=
# Set to "true" to force the sold-out state without a redeploy.
FORCE_SOLD_OUT=

# ── Admin + email ──────────────────────────────────────────
# Any long random string. Open /admin?k=<this value> once to get in.
ADMIN_TOKEN=
# Resend API key. Order emails are skipped entirely when blank.
RESEND_API_KEY=
EMAIL_FROM="Soubh <orders@yourdomain.com>"

# ── Shiprocket (Automated Shipping & WhatsApp Tracking) ────
# Account email & password on https://shiprocket.in
# When set, paid orders are automatically pushed to Shiprocket.
# Shiprocket Engage automatically triggers WhatsApp notifications to customers.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location name as saved in Shiprocket Settings → Pickup Addresses (default: Primary)
SHIPROCKET_PICKUP_LOCATION=Primary

