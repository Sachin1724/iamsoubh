# Copy to .env.local and fill in. Nothing here is committed.

# ── Razorpay ───────────────────────────────────────────────
# Test keys during development, live keys at launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in Razorpay Dashboard → Webhooks.
# Subscribe to: payment.captured (only — a second event means a second email)
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID. This one reaches the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Admin page (/admin) ────────────────────────────────────
# HTTP Basic credentials for the order list and the Shiprocket CSV.
# Leave either blank and the page stays locked for everyone.
ADMIN_USER=
ADMIN_PASS=

# ── Tracking (optional; each is skipped if blank) ──────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# ── Operations (optional) ──────────────────────────────────
# Slack or Telegram webhook. Alerts when an order email fails to send.
ALERT_WEBHOOK_URL=
# Set to "true" to force the sold-out state without a redeploy.
FORCE_SOLD_OUT=

# ── Email ──────────────────────────────────────────────────
# Where the "new order" mail lands. This is the whole admin system now.
ADMIN_EMAIL=
# Resend API key. Order emails are skipped entirely when blank.
RESEND_API_KEY=
EMAIL_FROM="Soubh <orders@yourdomain.com>"
