# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Anything starting NEXT_PUBLIC_ is baked in at build time: redeploy after changing it.

# ════════════════════════ REQUIRED ════════════════════════

# ── Site ───────────────────────────────────────────────────
# Your live domain, no trailing slash. Used for the product image on the Razorpay checkout.
NEXT_PUBLIC_SITE_URL=https://iamsoubh.com

# ── Razorpay ───────────────────────────────────────────────
# Razorpay Dashboard → Account & Settings → API Keys → Generate Key.
# Use rzp_test_… keys locally, rzp_live_… keys in Vercel production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID. This copy reaches the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay Dashboard → Account & Settings → Webhooks → Add New Webhook:
#   URL: https://<your-domain>/api/razorpay-webhook
#   Event: payment.captured (only this one)
#   Secret: make up a long random string, paste it there and here.
RAZORPAY_WEBHOOK_SECRET=

# ── Google Sheet (orders, creators, bulk, waitlist) ────────
# Google Sheet → Extensions → Apps Script → paste docs/google-sheet-script.gs →
# Deploy → New deployment → Web app (Execute as: Me, Access: Anyone) → copy the URL.
GOOGLE_SHEET_WEBHOOK_URL=
# Make up a long random string; put the same value in SECRET at the top of the script.
GOOGLE_SHEET_SECRET=

# ── Admin page (/admin, Shiprocket CSV) ────────────────────
# Choose your own. Leave either blank and the page stays locked for everyone.
ADMIN_USER=
ADMIN_PASS=

# ── Stock ──────────────────────────────────────────────────
# Boxes in this batch. Sold boxes are counted live from Razorpay.
NEXT_PUBLIC_BATCH_CAP=500
# The live "X left" counter shows once fewer than this many boxes are left.
NEXT_PUBLIC_COUNTER_THRESHOLD=300

# ── Prices (₹ per box; applies to every box in the order) ──
NEXT_PUBLIC_PRICE_1_BOX=329
NEXT_PUBLIC_PRICE_3_PLUS=283
NEXT_PUBLIC_PRICE_10_PLUS=250
# Single-box price once batch 1 sells out.
NEXT_PUBLIC_PRICE_AFTER_BATCH=339

# ════════════════════════ OPTIONAL ════════════════════════

# Meta Events Manager → Data sources → your Pixel → Pixel ID (numbers only).
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics → Admin → Data streams → your web stream → Measurement ID (G-XXXXXXX).
NEXT_PUBLIC_GA4_ID=
# Slack (Apps → Incoming Webhooks) or similar URL. Gets a message when an order fails to log.
ALERT_WEBHOOK_URL=
# "true" closes sales instantly without a redeploy (server side).
FORCE_SOLD_OUT=
