# Copy to .env.local and fill in. Nothing here is committed.

# Public address of the site. Used for product images on the Razorpay checkout and
# the links in emails. Falls back to https://iamsoubh.com when blank.
NEXT_PUBLIC_SITE_URL=

# ── Razorpay ───────────────────────────────────────────────
# Test keys during development, live keys at launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in Razorpay Dashboard → Webhooks.
# Subscribe to: payment.captured (only — a second event means a second email)
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID. This one reaches the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Admin page (/admin) ────────────────────────────────────
# HTTP Basic credentials for the order list and the Shiprocket CSV.
# Leave either blank and the page stays locked for everyone.
ADMIN_USER=
ADMIN_PASS=

# ── Tracking (optional; each is skipped if blank) ──────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# ── Operations (optional) ──────────────────────────────────
# Slack or Telegram webhook. Alerts when logging an order to the sheet fails.
ALERT_WEBHOOK_URL=
# Set to "true" to force the sold-out state without a redeploy.
FORCE_SOLD_OUT=

# ── Prices (₹ per box; the price applies to every box in the order) ──
# Rebuild/redeploy after changing: these are baked into the page and the server.
NEXT_PUBLIC_PRICE_1_BOX=329
NEXT_PUBLIC_PRICE_3_PLUS=283
NEXT_PUBLIC_PRICE_10_PLUS=250
# Single-box price once batch 1 sells out.
NEXT_PUBLIC_PRICE_AFTER_BATCH=339

# ── Google Sheet logging (optional) ────────────────────────
# Apps Script web app URL (see docs/google-sheet-script.gs). Tabs Creator, Bulk, Orders and Waitlist
# are made automatically. Leave blank to skip. The secret must match the one in the script.
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=

# ── Stock ──────────────────────────────────────────────────
# Boxes in this batch. Sold boxes are counted live from Razorpay, so this is the only number to edit.
# Rebuild/redeploy after changing. FORCE_SOLD_OUT=true (above) still closes it instantly.
NEXT_PUBLIC_BATCH_CAP=500
# The live "X left" counter shows once fewer than this many boxes are left.
NEXT_PUBLIC_COUNTER_THRESHOLD=300
